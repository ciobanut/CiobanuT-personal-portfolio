---
import { getCollection, render } from 'astro:content'
import WorklogLayout from '@layouts/WorklogLayout.astro'

export async function getStaticPaths() {
  const worklogEntries = await getCollection('worklogs')
  return worklogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<WorklogLayout frontmatter={entry.data}>
  <Content />
</WorklogLayout>