---
const { frontmatter } = Astro.props

import BaseLayout from './Base/BaseLayout.astro'
import FlexColGap5 from '@components/FlexColGap5.astro'
import CallToAction from '@components/HomePageSections/CallToAction.astro'

// Parse DD-MM-YYYY for display
const [d, m, y] = (frontmatter.pubDate || '').split('-')
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const formattedDate = `${parseInt(d)} ${months[parseInt(m) - 1]} ${y}`
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="flex flex-col gap-14">
    <FlexColGap5>

      <div class="flex flex-col gap-2">
        <time class="font-mono text-sm text-slate-400 dark:text-slate-500">
          {formattedDate}
        </time>

        <h1 class="text-2xl font-bold leading-tight tracking-tight text-slate-900 dark:text-slate-100">
          {frontmatter.title}
        </h1>

        {
          frontmatter.description && (
            <p class="text-md leading-relaxed text-slate-600 dark:text-slate-400 sm:text-lg">
              {frontmatter.description}
            </p>
          )
        }
      </div>

      <div class="prose prose-slate max-w-none font-serif text-lg leading-7 dark:prose-invert">
        <slot />
      </div>

    </FlexColGap5>
  </article>

  <CallToAction />
</BaseLayout>