---
import { Icon } from 'astro-icon/components';
const { title, icon, desc } = Astro.props;
---

<header class="flex flex-col gap-3 items-center mb-8 text-center">
	{icon && <Icon name={icon} class="text-primary-400" size={32} />}
	<h4
		class="text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl text-center dark:text-slate-100"
	>
		{title}
	</h4>

	{
		desc && (
			<>
				<p class="max-w-[400px] text-slate-500 text-l dark:text-slate-400" style="text-wrap: balance">{desc}</p>
			</>
		)
	}
</header>
