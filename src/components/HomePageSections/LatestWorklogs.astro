---
import Button from '@components/Form/Button.astro'
import { Icon } from 'astro-icon/components'
import GetWorklogs from '@components/Worklog/GetWorklogs.astro'
---

<section class="flex flex-col gap-3">
  <header class="flex items-center justify-between">
    <div class="flex items-center">
      <Icon name="ph:list-dashes" class="mr-3 h-6 w-6 text-primary-500" />

      <h3 class="text-xl font-bold text-primary-950 sm:text-xl dark:text-primary-200">Latest Work Logs</h3>
    </div>

    <Button href="/works/logs" title="View All" icon="ph:arrow-right-bold" variant="link" size="md" />
  </header>

  <div class="rounded-xl border border-slate-200 dark:border-slate-700">
    <GetWorklogs limit={10} showStackBadges={true} />
  </div>
</section>