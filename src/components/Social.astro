---
import { Icon } from 'astro-icon/components';
const { logo, link, title } = Astro.props;
---

<a
  href={link}
  target="_blank"
  class="text-slate-500 hover:text-slate-900 dark:text-stone-400 dark:hover:text-stone-100"
  aria-label={"Open page " + title}
>
  <Icon name={logo} size={24} />
</a>
