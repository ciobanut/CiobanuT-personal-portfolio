---
import { getCollection } from 'astro:content'
import { resolveWorklogProjects, type ProjectRef } from '../../lib/projects'

const { limit, showStackBadges = false } = Astro.props

const allWorklogs = (await getCollection('worklogs'))
  .sort((a, b) => {
    // Parse DD-MM-YYYY for sorting
    const [aD, aM, aY] = a.data.pubDate.split('-')
    const [bD, bM, bY] = b.data.pubDate.split('-')
    return new Date(bY, bM - 1, bD) - new Date(aY, aM - 1, aD)
  })

// Count stack frequency across all worklogs (before slicing)
const stackFreq = new Map()
for (const entry of allWorklogs) {
  const stacks = entry.data.stack ?? []
  for (const s of stacks) {
    stackFreq.set(s, (stackFreq.get(s) ?? 0) + 1)
  }
}

// Sort each entry's stacks by global frequency descending, then alphabetically
for (const entry of allWorklogs) {
  const stacks = entry.data.stack ?? []
  entry.data.stack = [...stacks].sort((a, b) => {
    const freqDiff = (stackFreq.get(b) ?? 0) - (stackFreq.get(a) ?? 0)
    return freqDiff !== 0 ? freqDiff : a.localeCompare(b)
  })
}

const visibleWorklogs = allWorklogs.slice(0, limit || undefined)

// Resolve the friendly project name(s) for each worklog (via its GitHub repos)
const projectsByEntry = new Map<string, ProjectRef[]>()
for (const entry of visibleWorklogs) {
  projectsByEntry.set(entry.id, await resolveWorklogProjects(entry.data.github_repos))
}
---

<section class="flex flex-col divide-y border border-slate-200 rounded-xl divide-slate-200 dark:border-stone-700/60 dark:divide-stone-700">
  {
    visibleWorklogs.map((entry) => {
      // Format date for display: "DD Mon YYYY"
      const [d, m, y] = entry.data.pubDate.split('-')
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
      const formattedDate = `${parseInt(d)} ${months[parseInt(m) - 1]} ${y}`

      return (
        <a
          href={`/works/logs/${entry.id}`}
          class="group flex items-baseline gap-4 px-2 py-1.5 transition-colors"
        >
          <span class="shrink-0 font-mono text-sm text-slate-400 dark:text-stone-500 min-w-24">
            {formattedDate}
          </span>
          <span class="flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-1">
            <span class="truncate text-sm font-medium text-slate-800 dark:text-stone-200 group-hover:text-primary-500 dark:group-hover:text-primary-400">
              {entry.data.title}
            </span>
            {/* {
              (projectsByEntry.get(entry.id) ?? []).length > 0 && (
                <div class="flex flex-wrap gap-1">
                  {(projectsByEntry.get(entry.id) ?? []).map((p) => (
                    <span class="inline-flex items-center rounded-full bg-primary-50 px-2 py-0.5 text-xs text-primary-700 dark:bg-primary-950 dark:text-primary-300">
                      {p.displayName}
                    </span>
                  ))}
                </div>
              )
            }
            {
              showStackBadges && entry.data.stack?.length > 0 && (
                <span class="flex flex-wrap gap-1">
                  {entry.data.stack.map((s) => (
                    <span class="inline-flex items-center rounded-full  text-xs text-slate-600 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-400">
                      {s},
                    </span>
                  ))}
                </span>
              )
            } */}
          </span>
        </a>
      )
    })
  }
</section>